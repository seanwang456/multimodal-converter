# ===== 应用 =====
APP_ENV=development
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# 前端构建期注入的 API 基址；部署经 Caddy 同源时留空（走相对 /api）
WEB_API_BASE_URL=
# Next 服务端 /api 反代目标（本地 dev 默认 localhost:8000；docker 由 compose 注入 http://api:8000）
API_PROXY_TARGET=http://localhost:8000

# ===== 存储 & 任务 =====
STORAGE_ROOT=./storage
SQLITE_PATH=./storage/app.db
FILE_RETENTION_HOURS=24
MAX_CONCURRENT_JOBS=4
CLEANUP_INTERVAL_SECONDS=600
REDIS_URL=redis://redis:6379/0
# 任务运行模式：auto(默认,Redis优先,dev回退Inline) | redis(强制,fail-fast) | inline(同步,测试/本地)
JOB_RUNNER_MODE=auto

# ===== 文件大小上限（MB，规格 §6）=====
MAX_IMAGE_MB=20
MAX_PDF_MB=50
MAX_WORD_MB=30
MAX_PPT_MB=50
MAX_EXCEL_MB=30
MAX_TXT_MB=10
MAX_AUDIO_MB=100
MAX_WAV_MB=200
MAX_VIDEO_MB=500

# ===== 多模态 provider（OCR / ASR）=====
# OCR（图片→文字）走 OpenAI 兼容 /chat/completions + image_url，任意兼容视觉端点均可：
LLM_BASE_URL=
LLM_API_KEY=
LLM_VISION_MODEL=              # 视觉模型名，如 qwen3.6-flash / qwen-vl-ocr / doubao-seed-2-0-mini-260428

# ----- ASR（音频/视频→文字）后端：aliyun | volcano | openai -----
# 三选一。aliyun / volcano 为「公网回拉音频」模式（需 PUBLIC_BASE_URL 可达）；
# openai 为 Whisper 兼容（直接上传字节，无需 PUBLIC_BASE_URL）。
ASR_PROVIDER=aliyun

# ① 阿里云百炼「千问3-ASR-Flash-Filetrans」（DashScope 异步，推荐）
#    主机默认从 LLM_BASE_URL 推导（自动去掉 /compatible-mode/v1）；key 默认复用 LLM_API_KEY。
ALIYUN_ASR_MODEL=qwen3-asr-flash-filetrans
ALIYUN_ASR_BASE_URL=           # 留空=从 LLM_BASE_URL 推导；也可显式填 https://<ws-id>.cn-beijing.maas.aliyuncs.com
ALIYUN_ASR_API_KEY=            # 留空=复用 LLM_API_KEY

# ② 火山豆包「录音文件识别（标准版）」——文档 docs.volcengine.com/6561/1354868
VOLCANO_ASR_API_KEY=
VOLCANO_ASR_RESOURCE_ID=volc.bigasr.auc
VOLCANO_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel

# ③ openai：Whisper 兼容，走 {LLM_BASE_URL}/audio/transcriptions，模型用 LLM_ASR_MODEL
LLM_ASR_MODEL=

# 阿里云 filetrans / 火山均为回拉模式：必须公网可达（Caddy 域名或隧道）；localhost 不可用
PUBLIC_BASE_URL=
# 签名音频下载 token 密钥（worker 与 api 共享；留空则用对应 ASR 的 API Key 派生）
ASR_SOURCE_SECRET=
ASR_SOURCE_TTL_SECONDS=1800
ASR_QUERY_TIMEOUT_SECONDS=1080
ASR_QUERY_INTERVAL_SECONDS=5

# ===== 系统级二进制 =====
LIBREOFFICE_BIN=libreoffice
FFMPEG_BIN=ffmpeg

# ===== 部署：Caddy 域名驱动（留空=本地反代；填域名=自动 TLS）=====
CADDY_DOMAIN=
